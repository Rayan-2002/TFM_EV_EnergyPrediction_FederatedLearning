<configuration>
    <input>
        <net-file value="bcn.net.xml"/>
        <route-files value="bcn.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="900"/>
        <step-length value="1"/>
    </time>

    <processing>
        <ignore-route-errors value="true"/>
    </processing>
</configuration>
